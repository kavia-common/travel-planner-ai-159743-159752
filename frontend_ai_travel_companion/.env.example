# React environment variables (must be prefixed with REACT_APP_)
REACT_APP_OPENAI_API_KEY=
REACT_APP_OPENAI_BASE_URL=https://api.openai.com/v1
REACT_APP_MAPBOX_TOKEN=
REACT_APP_WEATHER_API_KEY=
REACT_APP_TICKETMASTER_API_KEY=
REACT_APP_EVENTBRITE_TOKEN=
REACT_APP_SITE_URL=http://localhost:3000

# Optional: change default OpenAI model
REACT_APP_OPENAI_MODEL=gpt-4o-mini

# Notes:
# - Never commit your real .env. Keep secrets out of version control.
# - In production, consider using a backend proxy for third-party APIs to avoid exposing keys in the browser.
