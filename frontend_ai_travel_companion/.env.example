# Demo mode
# Set to true to force demo/sample data. If not set, demo mode auto-enables when API keys are missing.
REACT_APP_DEMO_MODE=true

# OpenAI (either name works)
#REACT_APP_OPENAI_API_KEY=
#OPENAI_API_KEY=
# Optional:
#REACT_APP_OPENAI_BASE_URL=https://api.openai.com/v1
#REACT_APP_OPENAI_MODEL=gpt-4o-mini

# Mapbox (either name works)
#REACT_APP_MAPBOX_TOKEN=
#REACT_APP_MAPBOX_ACCESS_TOKEN=
#MAPBOX_ACCESS_TOKEN=

# OpenWeatherMap (either name works)
#REACT_APP_WEATHER_API_KEY=
#REACT_APP_OPENWEATHERMAP_API_KEY=
#OPENWEATHERMAP_API_KEY=

# Ticketmaster
#REACT_APP_TICKETMASTER_API_KEY=
#TICKETMASTER_API_KEY=

# Eventbrite
#REACT_APP_EVENTBRITE_TOKEN=
#REACT_APP_EVENTBRITE_API_KEY=
#EVENTBRITE_API_KEY=
